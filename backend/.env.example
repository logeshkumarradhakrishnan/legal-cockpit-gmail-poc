# Copy to .env and fill in. NEVER commit the real .env.
# In Azure, pull secret values from Key Vault, not from a file.

# Processing mode: human_in_loop (consent before forwarding) or auto
DEFAULT_MODE=human_in_loop
# In auto mode, suggestions below this confidence still go to the owner for consent
MIN_CONFIDENCE=0.55

# Where approved mail is delivered, and the address this service sends from
LEGAL_MAILBOX=legal.intake@example.com
# Comma-separated. Mail already copied to any of these is excluded.
LEGAL_TEAM_ADDRESSES=

# Public HTTPS URL of this service (Graph webhook + consent links point here)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Signs consent links. Use a long random value: python -c "import secrets;print(secrets.token_urlsafe(48))"
CONSENT_SIGNING_KEY=
CONSENT_TTL_HOURS=72

# Microsoft Graph. Leave blank to run stubbed (sends are logged, not sent).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_WEBHOOK_CLIENT_STATE=change-me

# Azure OpenAI. Leave blank to use the deterministic fallback classifier.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure AI Document Intelligence for attachment OCR (incl. Hindi/Kannada). Optional.
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_API_KEY=

AUDIT_LOG_PATH=audit.log.jsonl

# --- Legal Cockpit sign-in ---
# entra in Azure. dev = simulated sign-in with sample users, for local demos only.
AUTH_MODE=dev
ENTRA_TENANT_ID=
# Application ID URI of the API app registration
ENTRA_API_AUDIENCE=api://legal-cockpit-api
# Legal team members and reporting lines (see directory.example.json)
DIRECTORY_PATH=directory.json
# Frontend origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:5173
