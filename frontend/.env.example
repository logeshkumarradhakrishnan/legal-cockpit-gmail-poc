# Backend URL (no trailing slash)
VITE_API_BASE=http://127.0.0.1:8000

# "dev" shows a role switcher and sends X-Dev-User (demos only).
# "entra" signs in with Microsoft Entra ID (production).
VITE_AUTH_MODE=dev

# Entra settings (only for VITE_AUTH_MODE=entra)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# The scope exposed by the API app registration, e.g. api://legal-cockpit-api/access_as_user
VITE_API_SCOPE=
